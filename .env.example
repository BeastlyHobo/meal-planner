# Copy to .env and set a real password before the first `docker compose up -d`.
POSTGRES_DB=harvest_db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=changeme

# Which published image to run. Pin to a release (e.g. v1.2.0) if you would rather
# updates be deliberate than automatic.
HARVEST_TAG=latest

# Only needed for host-side scripts (npm run seed:meal-plan, meal-plan:publish,
# settings:brief, db:migrate) run against the dev stack. `localhost` is correct here
# because those scripts run on your machine, not in a container.
#
# The containers ignore this and build their own URL pointing at the `db` service. To
# override that — say, to use a Postgres you already run elsewhere — set
# HARVEST_DATABASE_URL instead, and drop the `db` service from the compose file.
DATABASE_URL=postgresql://harvest:changeme@localhost:5432/harvest_db
